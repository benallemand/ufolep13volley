DB_NAME=<database_name>
DB_USER=<username_for_db>
DB_PASSWORD=<password_for_db_user>
DB_SERVER=<server_name>
DB_SOCKET=<socket file path if any>
DB_PORT=<3306 most of the time>

# Pour .env.docker (dev local ET home server), viser le conteneur Mailpit :
#   MAIL_HOST=mailpit / MAIL_FUNCTION=smtp / MAIL_SMTPAUTH=false
#   MAIL_USERNAME=noreply@ufolep13volley.test / MAIL_PASSWORD= (vide)
#   MAIL_SMTPSECURE= (vide) / MAIL_PORT=1025
# Attention : si MAIL_USERNAME vaut benallemand@gmail.com, Emails.php force TOUS
# les destinataires vers cette adresse. Ne remettre un vrai SMTP qu'en connaissance
# de cause — .env.docker n'est pas versionné, chaque machine a le sien.
MAIL_HOST=<hostname for email server, or 'mailpit' to catch everything>
MAIL_FUNCTION=<mail or smtp>
MAIL_SMTPAUTH=<bool to set smtp auth or not>
MAIL_USERNAME=<username for email sending — also used as the From address>
MAIL_PASSWORD=<password for email sending>
MAIL_SMTPSECURE=<protocol for smtp secure, e.g. 'ssl'. empty for mailpit>
MAIL_PORT=<port for smtp, e.g. 465. 1025 for mailpit>
COVID_MODE=<true to enable unlimited reports, false for 1 report max>
FLICKR_API_KEY=<your flickr api key if you have one (for public images display). leave blank if not needed>
FACEBOOK_PAGE_ID=<your facebook page id (for public images display from the page). leave blank if not needed>
FACEBOOK_PAGE_TOKEN=<never-expiring facebook page access token. leave blank to fall back on flickr>
PROXY_URL=<your proxy url, if any. it is used for Unirest requests, leave blank if not needed>
SEEDING_TOURNAMENT_WEEK=<text to describe which week will host the seeding tournament, e.g. "semaine du 14 au 18 octobre 2024". leave blank if not needed>