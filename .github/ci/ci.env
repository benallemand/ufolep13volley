# Environnement du job PHPUnit de la CI (.github/workflows/tests.yml).
# Copie en .env a la racine avant de lancer PHPUnit : phpdotenv lit un fichier
# sur le disque (classes/Database.php, classes/Configuration.php).
#
# Valeurs bidon volontaires pour tout ce qui n'est pas la base : aucun test ne
# doit joindre un service externe. MAIL_FUNCTION=mail evite toute tentative de
# connexion SMTP sortante depuis le runner.

DB_NAME=ufolep_13volley
DB_USER=root
DB_PASSWORD=test
DB_SERVER=127.0.0.1
DB_SOCKET=
DB_PORT=3306

MAIL_HOST=localhost
MAIL_FUNCTION=mail
MAIL_SMTPAUTH=false
MAIL_USERNAME=ci@example.com
MAIL_PASSWORD=ci
MAIL_SMTPSECURE=
MAIL_PORT=25

COVID_MODE=false
FLICKR_API_KEY=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
PROXY_URL=
SEEDING_TOURNAMENT_WEEK=
