# Environnement du job E2E nocturne (.github/workflows/e2e-nightly.yml), monté
# comme `.env` dans le conteneur php. `Dotenv::createImmutable` exige un
# fichier sur le disque : des variables d'environnement seules ne suffisent pas.
#
# Même esprit que `ci.env` : valeurs bidon pour tout ce qui n'est pas la base,
# aucun test ne doit joindre un service externe. Seule différence, la base est
# le service `db` de `docker-compose.e2e-ci.yml` et non `127.0.0.1`.

DB_NAME=ufolep_13volley
DB_USER=root
DB_PASSWORD=test
DB_SERVER=db
DB_SOCKET=
DB_PORT=3306

MAIL_HOST=localhost
MAIL_FUNCTION=mail
MAIL_SMTPAUTH=false
MAIL_USERNAME=e2e@example.com
MAIL_PASSWORD=e2e
MAIL_SMTPSECURE=
MAIL_PORT=25

COVID_MODE=false
FLICKR_API_KEY=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_TOKEN=
PROXY_URL=
SEEDING_TOURNAMENT_WEEK=
