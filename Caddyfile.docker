biggyben.freeboxos.fr {
	# Boîte de réception de test (Mailpit). Elle contient des liens de
	# réinitialisation valides et des mots de passe en clair : accès protégé
	# par mot de passe, et servi en HTTPS sur le 443 déjà ouvert — pas de port
	# supplémentaire à rediriger sur la Freebox.
	# Mailpit tourne avec MP_WEBROOT=mailpit : on ne retire donc PAS le préfixe.
	handle /mailpit* {
		basic_auth {
			mailpit $2a$14$aykjdAc7mWNfH67CQe.qLeiK5CSk2.0Zk1iNL.Mmt8eUrYV493Euq
		}
		reverse_proxy mailpit:8025
	}

	handle {
		reverse_proxy php:80
	}
}
